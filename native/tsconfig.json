{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["react", "react-native"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
