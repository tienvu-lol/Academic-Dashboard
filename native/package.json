{
  "name": "academic-dashboard-windows",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "windows": "react-native run-windows --arch x64",
    "typecheck": "tsc --noEmit",
    "bundle": "react-native bundle --platform windows --dev false --entry-file index.js --bundle-output windows/AcademicDashboard/Bundle/index.windows.bundle --assets-dest windows/AcademicDashboard/Bundle",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-windows": "0.84.0",
    "react-native-url-polyfill": "2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": { "node": ">=22.11.0" }
}