{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dashboard: Start development server",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Dashboard: Type-check",
      "type": "shell",
      "command": "pnpm typecheck",
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "Dashboard: Production build",
      "type": "shell",
      "command": "pnpm build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
